# ┌─────────────────────────────────────────┐
# │  APPLICATION                            │
# └─────────────────────────────────────────┘
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=id
APP_TIMEZONE=Asia/Makassar

# ┌─────────────────────────────────────────┐
# │  DATABASE                               │
# └─────────────────────────────────────────┘
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret

# ┌─────────────────────────────────────────┐
# │  REDIS                                  │
# └─────────────────────────────────────────┘
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# ┌─────────────────────────────────────────┐
# │  CACHE / SESSION / QUEUE                │
# └─────────────────────────────────────────┘
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# ┌─────────────────────────────────────────┐
# │  MAIL                                   │
# └─────────────────────────────────────────┘
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ┌─────────────────────────────────────────┐
# │  FILESYSTEM                             │
# └─────────────────────────────────────────┘
FILESYSTEM_DISK=local

# ┌─────────────────────────────────────────┐
# │  LOGGING                                │
# └─────────────────────────────────────────┘
LOG_CHANNEL=stack
LOG_LEVEL=debug